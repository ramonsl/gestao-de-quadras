# Banco de dados (Neon PostgreSQL ou compatível)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=sua_chave_aleatoria_min_32_chars

# Resend (e-mail transacional) — https://resend.com
RESEND_API_KEY=re_sua_chave_aqui

# URL base da aplicação (necessário para links nos e-mails)
NEXTAUTH_URL=http://localhost:3000

# Em desenvolvimento: slug do tenant ativo (em produção usa subdomínio)
TENANT_SLUG=arena-demo

# Redis — filas BullMQ (apps/worker) e status em tempo real do WhatsApp (WPP-01)
REDIS_URL=redis://localhost:6379
