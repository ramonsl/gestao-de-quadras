{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@gestao-de-quadras/db": ["../../packages/db/src/index.ts"],
      "@gestao-de-quadras/db/schema": ["../../packages/db/src/schema.ts"],
      "@gestao-de-quadras/core": ["../../packages/core/src/index.ts"],
      "@gestao-de-quadras/core/auth/auth.service": ["../../packages/core/src/auth/auth.service.ts"],
      "@gestao-de-quadras/core/email/email.provider": ["../../packages/core/src/email/email.provider.ts"],
      "@gestao-de-quadras/core/users/user.service": ["../../packages/core/src/users/user.service.ts"],
      "@gestao-de-quadras/core/users/modules": ["../../packages/core/src/users/modules.ts"],
      "@gestao-de-quadras/core/customers/customer.service": ["../../packages/core/src/customers/customer.service.ts"],
      "@gestao-de-quadras/core/product": ["../../packages/core/src/product/index.ts"],
      "@gestao-de-quadras/core/pdv": ["../../packages/core/src/pdv/index.ts"],
      "@gestao-de-quadras/core/pdv/comanda.service": ["../../packages/core/src/pdv/comanda.service.ts"],
      "@gestao-de-quadras/core/courts/court.service": ["../../packages/core/src/courts/court.service.ts"],
      "@gestao-de-quadras/core/courts/court-service.service": ["../../packages/core/src/courts/court-service.service.ts"],
      "@gestao-de-quadras/core/courts/court-time-slot.service": ["../../packages/core/src/courts/court-time-slot.service.ts"],
      "@gestao-de-quadras/core/classes/class-package.service": ["../../packages/core/src/classes/class-package.service.ts"],
      "@gestao-de-quadras/core/publicidade/ad-space.service": ["../../packages/core/src/publicidade/ad-space.service.ts"],
      "@gestao-de-quadras/core/publicidade/advertiser.service": ["../../packages/core/src/publicidade/advertiser.service.ts"],
      "@gestao-de-quadras/core/whatsapp/whatsapp-connection.service": ["../../packages/core/src/whatsapp/whatsapp-connection.service.ts"],
      "@gestao-de-quadras/messaging": ["../../packages/messaging/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
